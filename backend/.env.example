# runtime
NODE_ENV=production
PORT=3100
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=1mb

# auth — single-tenant LAB control-plane bearer; rotate and store outside Git
CONTROL_PLANE_API_TOKEN=change-me-with-a-long-random-secret
CONTROL_PLANE_TENANT_ID=1
CONTROL_PLANE_ADMIN_ENABLED=false

# database
DB_DIALECT=postgres
DB_PORT=5437
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# cors
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost
PROXY_PORT=3100

# voice provider controls
VOICE_PROVIDER_TIMEOUT_MS=10000

# LAB/control-plane kill switches — secure defaults
VOICE_DISPATCH_ENABLED=false
VOICE_PREFLIGHT_ENABLED=false
# Empty means no provider can dispatch. LAB example: elevenlabs
VOICE_ENABLED_PROVIDERS=
# Required when ElevenLabs dispatch is enabled.
VOICE_ELEVENLABS_AGENT_ALLOWLIST=
VOICE_ELEVENLABS_PHONE_ALLOWLIST=
ENABLE_LEGACY_TOKEN_PATHS=false
ENABLE_CURL_EXECUTOR=false

# Only used if ENABLE_CURL_EXECUTOR=true.
# Explicit hostnames only; HTTPS and GET/POST are enforced.
CURL_EXECUTOR_ALLOWED_HOSTS=
CURL_EXECUTOR_ALLOWED_HEADERS=
CURL_EXECUTOR_TIMEOUT_MS=10000

# deployment gates — never enable on the long-running API container by default
RUN_DB_MIGRATIONS=false
RUN_DB_SEEDS=false
DB_WAIT_SECONDS=60
