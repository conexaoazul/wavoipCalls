# Copy to .env.lab and keep it outside Git.
POSTGRES_DB=magica_voice_lab
POSTGRES_USER=magica_voice_lab
POSTGRES_PASSWORD=replace-with-random-secret

CONTROL_PLANE_API_TOKEN=replace-with-long-random-secret
CONTROL_PLANE_TENANT_ID=1

POSTGRES_EXPOSE_PORT=5438
BACKEND_EXPOSE_PORT=3110
FRONTEND_EXPOSE_PORT=3011

FRONTEND_URL=http://127.0.0.1:3011
BACKEND_URL=http://127.0.0.1:3110
REACT_APP_API_URL=http://127.0.0.1:3110

# Intentionally no ElevenLabs phone allowlist yet.
# The backend LAB image itself also defaults dispatch OFF.

# Deployment-local identifier for the dedicated LAB agent. This is not a secret,
# but it is intentionally not hardcoded in the public repository.
VOICE_ELEVENLABS_AGENT_ALLOWLIST=agent_0000000000000000000000000000
